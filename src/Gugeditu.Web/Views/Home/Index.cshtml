@using System.Text.Json
@model IEnumerable<Gugeditu.Web.Models.CoordinateDeviceViewModel>
@{
    ViewData["Title"] = "设备地图";
    var pointsJson = JsonSerializer.Serialize(Model);
}

<link rel="stylesheet" href="~/lib/leaflet/dist/leaflet.css" asp-append-version="true" />

<div style="display:flex; justify-content:space-between; align-items:center;" class="mb-2">
    <div>
        <h1 class="h3" style="margin:0;">设备地图</h1>
        <p style="margin:0;color:#555;">展示一个中国大陆设备（广东省）和一个美国设备（加利福尼亚州）</p>
    </div>
</div>

<div id="device-map" style="height: 520px; width: 100%; border: 1px solid #ccc; border-radius:4px;"></div>

<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>SN</th>
            <th>国家/地区</th>
            <th>坐标（十进制度）</th>
            <th>上报时间(UTC)</th>
            <th>速度(km/h)</th>
            <th>方向</th>
            <th>电量</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Sn</td>
                <td>@item.Country / @item.Region</td>
                <td>@item.Lat.ToString("F6"), @item.Lon.ToString("F6")</td>
                <td>@item.ReportingTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@item.Speed.ToString("F1")</td>
                <td>@item.Direction.ToString("F1")°</td>
                <td>@item.Power%</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="~/lib/leaflet/dist/leaflet.js" asp-append-version="true"></script>
    <script>
        (function () {
            const points = @Html.Raw(pointsJson);

            // initialise map with a light grey ocean background
            const map = L.map('device-map', { zoomControl: true });
            document.getElementById('device-map').style.background = '#d4e7f5';

            // load bundled world GeoJSON (countries-110m, no network required)
            fetch('/data/countries.geojson')
                .then(function (r) { return r.json(); })
                .then(function (geojson) {
                    L.geoJSON(geojson, {
                        style: {
                            color: '#888',
                            weight: 0.6,
                            fillColor: '#e8e0d4',
                            fillOpacity: 1
                        }
                    }).addTo(map);

                    // add markers after the layer is ready
                    const bounds = [];
                    points.forEach(function (p) {
                        const latlng = [p.Lat, p.Lon];
                        bounds.push(latlng);
                        const marker = L.marker(latlng).addTo(map);
                        marker.bindPopup(
                            '<strong>' + p.Sn + '</strong><br/>' +
                            p.Country + ' — ' + p.Region + '<br/>' +
                            '速度: ' + p.Speed + ' km/h<br/>' +
                            '方向: ' + p.Direction + '°<br/>' +
                            '电量: ' + p.Power + '%'
                        );
                    });

                    if (bounds.length > 0) {
                        map.fitBounds(bounds, { padding: [80, 80] });
                    }
                });
        }());
    </script>
}
